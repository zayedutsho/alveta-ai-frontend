# Template only. Put real settings in gitignored .env.local or your hosting environment.
# Existing application origin. Verify per environment before deployment.
PUBLIC_APP_ORIGIN=
# Public pricing/models API, verified from the deployed existing frontend.
# Only allowlisted production/staging origins; loopback exceptions require a loopback page.
PUBLIC_API_ORIGIN=
# No auth/payment secrets are needed here. See docs/integration-config.md.
# Only set once the marketing domain is agreed; controls canonical URL.
PUBLIC_SITE_ORIGIN=
# Keep previews and this partial implementation out of search results.
PUBLIC_INDEXABLE=false
# Published marketing content. Public dataset needs no read token.
SANITY_PROJECT_ID=
SANITY_DATASET=
# Optional server-only read token for private datasets; never use PUBLIC_ or SANITY_STUDIO_ prefixes.
SANITY_READ_TOKEN=
# Optional local-only setup value for the Sanity-to-Vercel publish webhook; keep the real URL private.
VERCEL_DEPLOY_HOOK_URL=
