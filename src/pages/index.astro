---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Announcement from '../components/layout/Announcement.astro';
import Header from '../components/layout/Header.astro';
import { landingContent } from '../content/landing';
import Hero from '../components/sections/Hero.astro';
import HeroBackground from '../components/sections/HeroBackground.astro';
import CustomerLogos from '../components/sections/CustomerLogos.astro';
import Features from '../components/sections/Features.astro';
import LatestModels from '../components/sections/LatestModels.astro';
import SubscriptionComparison from '../components/sections/SubscriptionComparison.astro';
import Pricing from '../components/sections/Pricing.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import { testimonialsContent } from '../content/testimonials';
import Faq from '../components/sections/Faq.astro';
import Articles from '../components/sections/Articles.astro';
import ClosingCta from '../components/sections/ClosingCta.astro';
import Footer from '../components/layout/Footer.astro';
import { faqContent, articlesContent, closingCtaContent, footerContent } from '../content/landing-end';
---
<MarketingLayout>
  <div class="masthead">
    <HeroBackground />
    <Announcement content={landingContent.announcement} />
    <Header />
    <main id="main" tabindex="-1">
      <div class="hero-area"><Hero content={landingContent.hero} /></div>
      <CustomerLogos content={landingContent.customerLogos} />
      <Features content={landingContent.features} />
      <LatestModels content={landingContent.models} />
      <SubscriptionComparison content={landingContent.subscriptionComparison} />
      <Pricing />
      <Testimonials content={testimonialsContent} />
      <Faq content={faqContent} />
      <Articles content={articlesContent} />
      <ClosingCta content={closingCtaContent} />
    </main>
    <Footer content={footerContent} />
  </div>
</MarketingLayout>
<style>
  .masthead { position: relative; isolation: isolate; min-height: 855px; }
  .hero-area { min-height: 721px; }
  @media (min-width: 768px) and (max-width: 900px) { .hero-area { min-height: 753.8552px; } }
  @media (max-width: 767px) { .masthead { min-height: 569px; } .hero-area { min-height: 467.8552px; } }
</style>
