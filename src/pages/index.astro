---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Announcement from '../components/layout/Announcement.astro';
import Header from '../components/layout/Header.astro';
import { loadMarketingContent } from '../lib/sanity';
import Hero from '../components/sections/Hero.astro';
import HeroBackground from '../components/sections/HeroBackground.astro';
import CustomerLogos from '../components/sections/CustomerLogos.astro';
import Features from '../components/sections/Features.astro';
import LatestModels from '../components/sections/LatestModels.astro';
import SubscriptionComparison from '../components/sections/SubscriptionComparison.astro';
import Pricing from '../components/sections/Pricing.astro';
import Faq from '../components/sections/Faq.astro';
import Articles from '../components/sections/Articles.astro';
import ClosingCta from '../components/sections/ClosingCta.astro';
import Footer from '../components/layout/Footer.astro';
const { content, media } = await loadMarketingContent();
Astro.locals.cmsMedia = media;
---
<MarketingLayout title={content.seo.title} description={content.seo.description} socialImageAlt={content.seo.socialImageAlt}>
  <div class="masthead">
    <HeroBackground />
    <Announcement content={content.announcement} />
    <Header content={content.navigation} />
    <main id="main" tabindex="-1">
      <div class="hero-area"><Hero content={content.hero} /></div>
      <CustomerLogos content={{...content.customerLogos, rows: content.customerLogos.rows.map(row => row.logos)}} />
      <Features content={content.features} />
      <LatestModels content={content.models} />
      <SubscriptionComparison content={content.subscriptionComparison} />
      <Pricing editorial={content.pricing} />
      <Faq content={{...content.faq, columns: content.faq.columns.map(column => column.items)}} />
      <Articles content={content.articles} />
      <ClosingCta content={content.closingCta} />
    </main>
    <Footer content={content.footer} />
  </div>
</MarketingLayout>
<style>
  .masthead { position: relative; isolation: isolate; min-height: 855px; }
  .hero-area { min-height: 721px; }
  @media (min-width: 768px) and (max-width: 900px) { .hero-area { min-height: 753.8552px; } }
  @media (max-width: 767px) { .masthead { min-height: 569px; } .hero-area { min-height: 467.8552px; } }
</style>
