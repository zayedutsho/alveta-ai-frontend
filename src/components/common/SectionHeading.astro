---
interface Props { heading: [string, string]; description: string; id: string; layout?: 'center' | 'split' | 'split-wide'; }
const { heading, description, id, layout = 'center' } = Astro.props;
---
<div class:list={['section-heading', layout]}>
  <h2 id={id}><span>{heading[0]}</span><span>{heading[1]}</span></h2>
  <p>{description}</p>
</div>
<style>
  .section-heading { max-width: 632px; margin-inline: auto; text-align: center; }
  h2 { font-size: 40px; line-height: 54px; font-weight: 500; color: var(--color-heading); }
  h2 span { display: block; }
  p { margin-top: var(--space-5); color: var(--color-paragraph); line-height: 1.5; }
  .split, .split-wide { max-width: none; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 487px); gap: 120px; align-items: end; text-align: left; }
  .split-wide { grid-template-columns: minmax(0, 1fr) minmax(0, 587px); align-items: start; }
  .split h2, .split-wide h2 { line-height: 52px; }
  .split p, .split-wide p { margin: 0; font-size: 18px; line-height: 1.35; }
  @media (max-width: 1023px) { .split, .split-wide { grid-template-columns: 1fr; gap: var(--space-6); } }
  @media (max-width: 767px) { h2 { font-size: 28px; line-height: 1.3; } p { font-size: 14px; } }
  @media (max-width: 767px) { .split h2, .split-wide h2 { line-height: 1.3; } .split p, .split-wide p { font-size: 16px; } }
</style>
