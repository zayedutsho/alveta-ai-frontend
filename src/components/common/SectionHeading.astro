---
interface Props { heading: [string, string]; description: string; id: string; }
const { heading, description, id } = Astro.props;
---
<div class="section-heading">
  <h2 id={id}><span>{heading[0]}</span><span>{heading[1]}</span></h2>
  <p>{description}</p>
</div>
<style>
  .section-heading { max-width: 632px; margin-inline: auto; text-align: center; }
  h2 { font-size: 40px; line-height: 54px; font-weight: 500; color: var(--color-heading); }
  h2 span { display: block; }
  p { margin-top: var(--space-5); color: var(--color-paragraph); line-height: 1.5; }
  @media (max-width: 767px) { h2 { font-size: 28px; line-height: 1.3; } p { font-size: 14px; } }
</style>
