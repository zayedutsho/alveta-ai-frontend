---
import FigmaAsset from '../common/FigmaAsset.astro';
---
<!-- Absolute geometry is limited to original decorative artwork, never content. -->
<div class="hero-background" aria-hidden="true">
  <img class="dots" src="/images/figma/background.png" alt="" />
  <div class="wing wing-left">
    <div class="layer left-shape"><FigmaAsset name="group3" /></div>
    <div class="layer left-detail"><FigmaAsset name="group4" /></div>
    <div class="layer left-overlay"><FigmaAsset name="group5" /></div>
  </div>
  <div class="wing wing-right">
    <div class="layer right-shape"><FigmaAsset name="group8" /></div>
    <div class="layer right-detail"><FigmaAsset name="group9" /></div>
    <div class="layer right-overlay"><FigmaAsset name="group10" /></div>
  </div>
  <div class="fader"></div>
  <div class="glow"><FigmaAsset name="bg" /></div>
</div>
<style>
  .hero-background { position: absolute; z-index: -1; pointer-events: none; overflow: clip; top: 38px; left: 0; width: 100%; height: 817px; background: linear-gradient(132.068deg, #f3f0ff, #f0f6ff); }
  .dots { position: absolute; top: 10.88%; left: 0; width: 100%; height: 59.39%; }
  .wing { position: absolute; top: 0; width: 500px; height: 900px; }
  .wing-left { left: -4px; }
  .wing-right { right: -4px; }
  .layer { position: absolute; mask-repeat: no-repeat; mask-composite: intersect; mask-size: 500px 900px, 1151.73px 753.75px, 1427.996px 900px; }
  .wing-left .layer { mask-image: url('/images/figma/group.svg'), url('/images/figma/group1.svg'), url('/images/figma/group2.svg'); }
  .wing-right .layer { mask-image: url('/images/figma/group.svg'), url('/images/figma/group6.svg'), url('/images/figma/group7.svg'); }
  .left-shape { left: -664px; top: 121.5px; width: 1146px; height: 750px; mask-position: 663.998px -121.5px, -2.865px -1.875px, 663.998px -121.5px; }
  .left-detail { left: 357.235px; top: 470.253px; width: 86.4px; height: 237.1px; mask-position: -357.235px -470.253px, -1024.098px -350.628px, -357.235px -470.253px; }
  .left-detail :global(img), .right-detail :global(img) { position: absolute; left: -.75px; top: -.75px; }
  .left-overlay { left: -1.5px; top: 0; width: 1428px; height: 900px; mask-position: 1.5px 0, -665.363px 119.625px, 1.5px 0; }
  .right-shape { left: 11.501px; top: 120px; width: 1146px; height: 750px; mask-position: -11.501px -120px, -2.868px -1.875px, -939.497px -120px; }
  .right-detail { left: 49.339px; top: 468.753px; width: 86.4px; height: 237.1px; transform: scaleX(-1); mask-position: -49.339px -468.753px, -40.706px -350.628px, -977.335px -468.753px; }
  .right-overlay { left: -929.496px; top: 0; width: 1428px; height: 900px; mask-position: 929.496px 0, 938.129px 118.125px, 1.5px 0; }
  .fader { position: absolute; bottom: 0; left: 0; width: 100%; height: 790px; background: linear-gradient(transparent 45%, white); }
  .glow { position: absolute; left: calc(50% - 1075px); top: 355px; }
  @media (max-width: 767px) {
    .hero-background { top: 100px; height: 469px; background: linear-gradient(117.265deg, #f3f0ff, #f0f6ff); }
    .dots { top: 6.22%; height: 33.93%; }
    .wing { transform: scale(.43978); }
    .wing-left { left: -63.4px; transform-origin: top left; }
    .wing-right { right: -63.4px; transform-origin: top right; }
    .fader { height: 450px; }
    .glow { top: 120px; left: calc(50% - 473px); transform: scale(.43978); transform-origin: top left; }
  }
</style>
