---
import type { ArticlesContent } from '../../content/landing-end';
interface Props { content: ArticlesContent; }
const { content } = Astro.props;
---
<section class="articles container" data-articles aria-labelledby="articles-heading">
  <div class="heading-row">
    <h2 id="articles-heading">{content.heading}</h2>
    <span class="coming-soon" role="status"><span>Coming Soon</span></span>
  </div>
  <div class="cards">{content.items.map((item, i) => <article>
    <div class:list={['image', { tall: i === 2 }]} aria-hidden="true"><img src={item.image} width="700" height="525" alt="" loading="lazy" decoding="async" /></div>
    <div class="copy"><p class="meta"><span>{item.category}</span><img src="/images/ending/articles-ellipse13.svg" width="4" height="4" alt="" loading="lazy" /><time datetime={item.date}>{item.dateLabel}</time></p>
      <div class="divider" aria-hidden="true"></div><h3>{item.title}</h3>
    </div>
  </article>)}</div>
</section>
<style>
  .articles { margin-block: 100px 60px; }
  .heading-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  h2 { font-size: 40px; line-height: 52px; font-weight: 500; color: var(--color-heading); }
  .coming-soon { position: relative; isolation: isolate; display: inline-flex; align-items: center; justify-content: center; overflow: hidden; min-height: 34px; padding: 2px; border-radius: var(--radius-pill); background: linear-gradient(110deg, #7d52f4, #ec9bcc, #f7bf6f, #7d52f4); background-size: 300% 100%; box-shadow: 0 6px 18px rgb(125 82 244 / 22%); animation: coming-soon-gradient 4s linear infinite; }
  .coming-soon::after { content: ''; position: absolute; inset: -50% -30%; z-index: -1; background: linear-gradient(115deg, transparent 38%, rgb(255 255 255 / 70%) 50%, transparent 62%); translate: -70% 0; animation: coming-soon-shine 2.8s ease-in-out infinite; }
  .coming-soon span { display: inline-flex; align-items: center; min-height: 30px; padding: 5px 14px; border-radius: inherit; background: rgb(255 255 255 / 92%); color: var(--color-primary-deep); font-size: 13px; font-weight: 500; line-height: 1; letter-spacing: .02em; white-space: nowrap; }
  @keyframes coming-soon-gradient { to { background-position: 300% 0; } }
  @keyframes coming-soon-shine { 0%, 45% { translate: -70% 0; } 75%, 100% { translate: 70% 0; } }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 44px; }
  article { min-width: 0; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 16px 16px 20px; box-shadow: var(--shadow-card); }
  .image { position: relative; aspect-ratio: 350 / 192; background: var(--color-primary); mask: url('/images/ending/articles-image.svg') 0 0 / 100% 100% no-repeat; }
  .image img { width: 100%; height: 100%; position: absolute; object-fit: cover; mix-blend-mode: luminosity; }
  .image.tall img { height: 136.72%; top: .03%; object-fit: fill; }
  .copy { margin-top: 20px; }
  .meta { display: flex; align-items: center; gap: 8px; color: var(--color-paragraph); }
  .divider { margin-top: 8px; height: 1px; background: url('/images/ending/articles-line76.svg') 0 0 / 100% 1px no-repeat; }
  h3 { margin: 8px 0 0; font-size: 18px; line-height: 28px; font-weight: 500; color: var(--color-heading); }
  @media (max-width: 1023px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .coming-soon, .coming-soon::after { animation: none; } }
  @media (max-width: 767px) { .articles { margin-block: 48px; } .heading-row { gap: 12px; } h2 { font-size: 28px; line-height: 1.3; } .coming-soon { min-height: 30px; } .coming-soon span { min-height: 26px; padding: 4px 11px; font-size: 12px; } .cards { margin-top: 32px; gap: 16px; } }
  @media (max-width: 599px) { .cards { grid-template-columns: 1fr; } }
</style>
