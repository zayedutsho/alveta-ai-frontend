---
import type { ArticlesContent } from '../../content/landing-end';
interface Props { content: ArticlesContent; }
const { content } = Astro.props;
---
<section class="articles container" data-articles aria-labelledby="articles-heading" aria-describedby="articles-preview">
  <h2 id="articles-heading">{content.heading}</h2>
  <div class="cards">{content.items.map((item, i) => <article>
    <div class:list={['image', { tall: i === 2 }]} aria-hidden="true"><img src={item.image} width="700" height="525" alt="" loading="lazy" decoding="async" /></div>
    <div class="copy"><p class="meta"><span>{item.category}</span><img src="/images/ending/articles-ellipse13.svg" width="4" height="4" alt="" loading="lazy" /><time datetime={item.date}>{item.dateLabel}</time></p>
      <div class="divider" aria-hidden="true"></div><h3>{item.title}</h3>
    </div>
  </article>)}</div>
  <p class="notice" id="articles-preview">{content.notice}</p>
</section>
<style>
  .articles { margin-block: 100px 60px; }
  h2 { font-size: 40px; line-height: 52px; font-weight: 500; color: var(--color-heading); }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 44px; }
  article { min-width: 0; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 16px 16px 20px; box-shadow: var(--shadow-card); }
  .image { position: relative; aspect-ratio: 350 / 192; background: var(--color-primary); mask: url('/images/ending/articles-image.svg') 0 0 / 100% 100% no-repeat; }
  .image img { width: 100%; height: 100%; position: absolute; object-fit: cover; mix-blend-mode: luminosity; }
  .image.tall img { height: 136.72%; top: .03%; object-fit: fill; }
  .copy { margin-top: 20px; }
  .meta { display: flex; align-items: center; gap: 8px; color: var(--color-paragraph); }
  .divider { margin-top: 8px; height: 1px; background: url('/images/ending/articles-line76.svg') 0 0 / 100% 1px no-repeat; }
  h3 { margin: 8px 0 0; font-size: 18px; line-height: 28px; font-weight: 500; color: var(--color-heading); }
  .notice { margin-top: 24px; font-size: 12px; color: var(--color-paragraph); }
  @media (max-width: 1023px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .articles { margin-block: 48px; } h2 { font-size: 28px; line-height: 1.3; } .cards { margin-top: 32px; gap: 16px; } }
  @media (max-width: 599px) { .cards { grid-template-columns: 1fr; } }
</style>
