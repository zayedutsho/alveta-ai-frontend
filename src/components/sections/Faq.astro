---
import SectionHeading from '../common/SectionHeading.astro';
import type { FaqContent } from '../../content/landing-end';
interface Props { content: FaqContent; }
const { content } = Astro.props;
---
<section id="faq" class="faq container" data-faq aria-labelledby="faq-heading" aria-describedby="faq-preview">
  <SectionHeading id="faq-heading" heading={content.heading} description={content.description} />
  <div class="columns">{content.columns.map(column => <div class="column">{column.map(item => <details open={item.open} id={`faq-${item.id}`}>
    <summary>{item.question}<img src="/images/ending/faq-arrowdown01.svg" width="24" height="24" alt="" loading="lazy" /></summary>
    <p>{item.answer}</p>
  </details>)}</div>)}</div>
  <p class="notice" id="faq-preview">{content.notice}</p>
</section>
<style>
  .faq { margin-block: 100px; scroll-margin-top: 24px; }
  .columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; margin-top: var(--space-11); }
  .column { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
  details { border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: 0 1px 2px #1018280d; }
  details[open] { background: var(--color-surface); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 60px; padding: 16px 20px; cursor: pointer; list-style: none; font-size: 18px; font-weight: 500; line-height: 1.35; color: var(--color-heading); border-radius: inherit; }
  summary::-webkit-details-marker { display: none; }
  summary img { flex-shrink: 0; transition: transform .18s; }
  details[open] summary img { transform: scaleY(-1); }
  details p { padding: 0 20px 16px; color: var(--color-paragraph); }
  .notice { margin-top: 24px; font-size: 12px; color: var(--color-paragraph); }
  @media (max-width: 767px) { .faq { margin-block: 48px; } .columns { grid-template-columns: 1fr; gap: 16px; margin-top: 32px; } summary { font-size: 16px; gap: 16px; } }
</style>
