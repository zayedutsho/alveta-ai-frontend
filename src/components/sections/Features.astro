---
import type { FeaturesContent } from '../../types/content';
import SectionHeading from '../common/SectionHeading.astro';
import FeaturePanel from './FeaturePanel.astro';
interface Props { content: FeaturesContent; }
const { content } = Astro.props;
---
<section id="features" class="features container" aria-labelledby="features-heading" data-features>
  <SectionHeading id="features-heading" heading={content.heading} description={content.description} />
  <div class="feature-panels">{content.panels.map((panel, index) => <FeaturePanel content={panel} index={index} />)}</div>
</section>
<script>import '../../scripts/feature-stack';</script>
<style>
  .features { margin-top: 100px; margin-bottom: 72px; scroll-margin-top: 24px; }
  .feature-panels { display: grid; gap: var(--space-8); margin-top: var(--space-11); }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .features[data-stack-active] .feature-panels { isolation: isolate; }
    .features[data-stack-active] :global(.feature-panel) {
      position: sticky; top: calc(24px + var(--stack-index) * 12px);
      z-index: calc(var(--stack-index) + 1); align-self: start;
      scale: var(--stack-scale, 1); transform-origin: center top;
    }
    .features[data-stack-active] :global(.feature-panel[data-motion-entering]) { animation: none; }
  }
  @media (max-width: 767px) { .features { margin-top: 64px; margin-bottom: 44px; } .feature-panels { margin-top: 32px; gap: 24px; } }
</style>
