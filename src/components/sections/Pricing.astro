---
import { pricingContent as content } from '../../content/pricing';
import { publicApiOrigin } from '../../lib/public-catalog';
import { appLink } from '../../lib/app-links';
import SectionHeading from '../common/SectionHeading.astro';
import Button from '../common/Button.astro';
import FigmaAsset from '../common/FigmaAsset.astro';
---
<section id="pricing" class="pricing container" aria-labelledby="pricing-heading" data-pricing data-api-origin={publicApiOrigin} data-register={appLink('/register')} data-content={JSON.stringify(content)}>
  <SectionHeading id="pricing-heading" heading={content.heading} description={content.description} />
  <div class="pricing-controls" data-controls hidden>
    <fieldset><legend class="sr-only">Plan type</legend><label><input type="radio" name="plan-type" value="individual" checked />Individual</label><label data-team-option hidden><input type="radio" name="plan-type" value="team" />Team/Organization</label></fieldset>
    <label>Currency <select data-currency aria-label="Pricing currency"><option value="USD">USD</option><option value="BDT">BDT</option></select></label>
  </div>
  <p class="pricing-status" role="status" data-pricing-status>{content.labels.loading}</p>
  <button class="retry" type="button" data-pricing-retry hidden>{content.labels.retry}</button>
  <div class="plan-grid" data-plan-grid aria-busy="true">
    {[0, 1, 2, 3].map(() => <div class="plan-skeleton" aria-hidden="true"></div>)}
  </div>
  <p class="pricing-help"><a href={appLink('/#pricing')}>View current plans in Alveta<span aria-hidden="true"> →</span></a></p>
  <noscript><p>Enable JavaScript to load current prices here, or follow the link above to view plans in Alveta.</p></noscript>
  <template data-plan-template>
    <article class="plan">
      <div class="popular-label" data-popular-label hidden>{content.popularLabel}</div>
      <div class="plan-body">
        <h3 data-plan-name></h3><p class="plan-description" data-plan-description></p>
        <p class="plan-price"><strong data-price></strong><span data-price-period></span></p>
        <p class="currency-fallback" data-currency-fallback hidden>BDT unavailable; shown in USD.</p>
        <label class="seat-control" data-seat-control hidden>Seats <input data-seats type="number" inputmode="numeric" step="1" /></label>
        <p class="team-total" data-team-total hidden></p>
        <p class="token-value"><span aria-hidden="true"><FigmaAsset name="pricing-stars" /></span><span data-tokens></span></p>
        <Button href={appLink('/register')} variant="light" class="pricing-cta">{content.ctaLabel}</Button>
        <div class="plan-models"><div class="models-heading"><span>AI Models</span><span class="model-count" data-model-count></span></div><ul data-model-list></ul><details data-more-models hidden><summary><span data-more-label></span><span class="more-arrow" aria-hidden="true"><FigmaAsset name="pricing-arrowup01" /></span></summary><ul data-extra-models></ul></details><p data-model-status></p></div>
        <ul class="plan-features" data-plan-features></ul>
      </div>
    </article>
  </template>
  <template data-feature-template><li><span class="feature-yes" aria-hidden="true"><FigmaAsset name="pricing-icon" /></span><span class="feature-no" aria-hidden="true"><FigmaAsset name="pricing-container" /></span><span data-feature-label></span><span class="sr-only" data-feature-availability></span></li></template>
  <template data-model-template><li><span class="model-icon" data-model-icon></span><span data-model-name></span></li></template>
  <template data-provider-icon="openai"><FigmaAsset name="pricing-chatgpt" /></template>
  <template data-provider-icon="anthropic"><FigmaAsset name="pricing-claude" /></template>
  <template data-provider-icon="anthropic-popular"><FigmaAsset name="pricing-claude1" /></template>
  <template data-provider-icon="google"><span class="gemini-scale"><FigmaAsset name="model-gemini" /></span></template>
</section>
<script>import '../../scripts/pricing';</script>
<style>
  .pricing { margin-top: 85px; margin-bottom: 100px; scroll-margin-top: 24px; }
  .pricing :global(.section-heading h2) { line-height: 52px; }
  .pricing-controls { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 24px; font-size: 14px; }
  fieldset { display: flex; gap: 16px; margin: 0; padding: 8px 16px; border: 1px solid var(--color-border); border-radius: var(--radius-pill); }
  fieldset label { display: flex; align-items: center; gap: 6px; }
  input { accent-color: var(--color-primary); }
  select, .seat-control input { border: 1px solid var(--color-border); border-radius: 8px; padding: 8px; background: white; color: var(--color-heading); }
  .pricing-status, .pricing-help, noscript { text-align: center; font-size: 14px; }
  .pricing-status { margin-top: 24px; }
  .retry { display: block; margin: 16px auto; border: 1px solid var(--color-border); border-radius: 99px; padding: 10px 20px; background: var(--color-primary-wash); }
  .plan-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: stretch; gap: 24px; margin-top: 40px; min-height: 748px; }
  .plan, .plan-skeleton { min-width: 0; border: 1px solid var(--color-border); border-radius: 16px; background: white; box-shadow: var(--shadow-card); }
  .plan { margin-top: 12px; overflow-wrap: anywhere; }
  .plan-skeleton { min-height: 728px; background: var(--color-surface); }
  .plan.popular { margin-top: 0; padding: 4px; padding-top: 8px; border: 0; border-radius: 20px; background: linear-gradient(#8351ff, #e8dfff); }
  .plan.subtle { border-color: var(--color-feature-border); }
  .popular-label { text-align: center; color: white; margin-bottom: 8px; font-weight: 500; }
  .plan-body { height: 100%; padding: 24px 24px 32px; border-radius: 16px; background: white; }
  .popular .plan-body { height: calc(100% - 32px); }
  h3 { margin: 0; font-size: 24px; font-weight: 500; line-height: 29px; color: var(--color-heading); }
  .plan-description { margin-top: 4px; font-size: 14px; line-height: 1.4; color: var(--color-paragraph); }
  .plan-price { margin-top: 8px; color: var(--color-heading); }
  .plan-price strong { font-size: 28px; font-weight: 600; }
  .plan-price > span { font-size: 12px; margin-left: 4px; }
  .currency-fallback, .team-total { font-size: 12px; color: var(--color-paragraph); }
  .seat-control { display: flex; gap: 8px; align-items: center; margin-block: 8px; font-size: 14px; }
  .seat-control input { min-width: 0; width: 90px; }
  .token-value { display: flex; gap: 8px; align-items: center; min-height: 36px; margin-top: 8px; padding: 8px 10px; border: 1px solid #e8dfff; background: rgb(125 82 244 / 4%); border-radius: 4px; font-size: 14px; line-height: 1.4; }
  .pricing :global(.pricing-cta) { width: 100%; margin-top: 20px; font-size: 14px; font-weight: 500; letter-spacing: .42px; border: 1px solid var(--color-border); background: var(--color-surface); }
  .popular :global(.pricing-cta) { background: linear-gradient(#5424a5, #380e87); color: white; }
  .plan-models { margin-top: 16px; padding: 12px; border: 1px solid var(--color-border); border-radius: 12px; box-shadow: var(--shadow-card); min-height: 164px; }
  .models-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid var(--color-surface); padding-bottom: 8px; font-size: 12px; }
  .models-heading > span:first-child { text-transform: uppercase; letter-spacing: .24px; }
  .model-count { background: var(--color-primary-wash); color: var(--color-primary-deep); border-radius: 99px; padding: 2px 10px; }
  .plan-models ul { display: grid; gap: 6px; margin: 10px 0 0; padding: 0; list-style: none; }
  .plan-models :global(li) { display: flex; gap: 6px; align-items: center; font-size: 12px; line-height: 1.35; color: var(--color-paragraph); }
  .plan-models :global(.model-icon) { display: grid; flex: 0 0 20px; width: 20px; height: 20px; place-items: center; background: var(--color-surface); border-radius: 99px; overflow: clip; }
  .pricing :global(.gemini-scale) { width: 16.667px; height: 16.667px; }
  .pricing :global(.gemini-scale img) { transform: scale(.52084375); transform-origin: top left; }
  .plan-models p { font-size: 12px; margin-top: 10px; }
  summary { display: flex; gap: 4px; align-items: center; margin-top: 10px; cursor: pointer; font-size: 12px; font-weight: 500; color: var(--color-primary-deep); }
  summary::-webkit-details-marker { display: none; }
  .more-arrow { transform: scaleY(-1); }
  details[open] .more-arrow { transform: none; }
  .plan-features { display: grid; gap: 8px; margin: 16px 0 0; padding: 0; list-style: none; }
  .plan-features :global(li) { display: flex; gap: 8px; align-items: start; font-size: 14px; line-height: 1.4; color: var(--color-paragraph); }
  .feature-yes { display: grid; place-items: center; flex: 0 0 16px; height: 16px; margin-top: 2px; border-radius: 99px; background: var(--color-border); }
  .feature-no { flex: 0 0 16px; margin-top: 2px; display: none; }
  .plan-features :global(.unavailable .feature-yes) { display: none; }
  .plan-features :global(.unavailable .feature-no) { display: block; }
  .plan-features :global(.unavailable) { color: var(--color-muted); }
  .pricing-help { margin-top: 24px; color: var(--color-primary-deep); }
  @media (max-width: 1279px) { .plan-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .pricing { margin-block: 64px; } .pricing :global(.section-heading h2) { line-height: 1.3; } .plan-grid { gap: 20px; margin-top: 32px; } }
  @media (max-width: 599px) { .plan-grid { grid-template-columns: 1fr; } .plan { margin-top: 0; } .plan-body { padding: 24px; } }
</style>
