---
import { pricingContent as content } from '../../content/pricing';
import { publicApiOrigin } from '../../lib/public-catalog';
import { appLink } from '../../lib/app-links';
import SectionHeading from '../common/SectionHeading.astro';
import Button from '../common/Button.astro';
import FigmaAsset from '../common/FigmaAsset.astro';
---
<section id="pricing" class="pricing container" aria-labelledby="pricing-heading" data-pricing data-api-origin={publicApiOrigin} data-register={appLink('/register')} data-content={JSON.stringify(content)}>
  <SectionHeading id="pricing-heading" heading={content.heading} description={content.description} />
  <div class="pricing-controls" data-controls hidden>
    <fieldset class="toggle-pill">
      <legend class="sr-only">Plan type</legend>
      <label class="toggle-option" data-checked>
        <input type="radio" name="plan-type" value="individual" checked class="toggle-radio" />
        <svg class="toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Individual</span>
      </label>
      <label class="toggle-option" data-team-option hidden>
        <input type="radio" name="plan-type" value="team" aria-label="Team/Organization" class="toggle-radio" />
        <svg class="toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-3-3.87"/><path d="M9 21v-2a4 4 0 0 1 4-4h2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>Team Plan<span class="sr-only">/Organization</span></span>
      </label>
    </fieldset>
    <label class="currency-label sr-only">Currency <select data-currency aria-label="Pricing currency"><option value="USD">USD</option><option value="BDT">BDT</option></select></label>
  </div>
  <p class="pricing-status" role="status" data-pricing-status>{content.labels.loading}</p>
  <button class="retry" type="button" data-pricing-retry hidden>{content.labels.retry}</button>
  <div class="plan-grid" data-plan-grid aria-busy="true">
    {[0, 1, 2, 3].map(() => <div class="plan-skeleton" aria-hidden="true"></div>)}
  </div>
  <p class="pricing-help"><a href={appLink('/#pricing')}>View current plans in Alveta<span aria-hidden="true"> →</span></a></p>
  <noscript><p>Enable JavaScript to load current prices here, or follow the link above to view plans in Alveta.</p></noscript>
  <template data-plan-template>
    <article class="plan">
      <div class="popular-label" data-popular-label hidden>{content.popularLabel}</div>
      <div class="plan-body">
        <h3 data-plan-name></h3><p class="plan-description" data-plan-description></p>
        <p class="plan-price"><strong data-price></strong><span data-price-period></span></p>
        <p class="currency-fallback" data-currency-fallback hidden>BDT unavailable; shown in USD.</p>
        <label class="seat-control" data-seat-control hidden>Seats <input data-seats type="number" inputmode="numeric" step="1" /></label>
        <p class="team-total" data-team-total hidden></p>
        <p class="token-value"><span class="token-stars" aria-hidden="true"><FigmaAsset name="pricing-stars" /></span><span class="token-prefix">Includes </span><span data-tokens></span></p>
        <Button href={appLink('/register')} variant="light" class="pricing-cta">{content.ctaLabel}</Button>
        <div class="plan-models"><div class="models-heading"><span>AI Models</span><span class="model-count" data-model-count></span></div><ul data-model-list></ul><details data-more-models hidden><summary><span data-more-label></span><span class="more-arrow" aria-hidden="true"><FigmaAsset name="pricing-arrowup01" /></span></summary><ul data-extra-models></ul></details><p data-model-status></p></div>
        <ul class="plan-features" data-plan-features></ul>
      </div>
    </article>
  </template>
  <template data-feature-template><li><span class="feature-yes" aria-hidden="true"><FigmaAsset name="pricing-icon" /></span><span class="feature-no" aria-hidden="true"><FigmaAsset name="pricing-container" /></span><span data-feature-label></span><span class="sr-only" data-feature-availability></span></li></template>
  <template data-model-template><li><span class="model-icon" data-model-icon></span><span data-model-name></span></li></template>
  <template data-provider-icon="openai"><FigmaAsset name="pricing-chatgpt" /></template>
  <template data-provider-icon="anthropic"><FigmaAsset name="pricing-claude" /></template>
  <template data-provider-icon="anthropic-popular"><FigmaAsset name="pricing-claude1" /></template>
  <template data-provider-icon="google"><span class="gemini-scale"><FigmaAsset name="model-gemini" /></span></template>
</section>
<script>import '../../scripts/pricing';</script>
<style>
  .pricing { margin-top: 72px; margin-bottom: 96px; scroll-margin-top: 24px; }
  .pricing :global(.section-heading) { max-width: 580px; margin-inline: auto; text-align: center; }
  .pricing :global(.section-heading h2) { font-size: 38px; line-height: 1.25; font-weight: 600; color: #111827; letter-spacing: -0.02em; }
  .pricing :global(.section-heading p) { margin-top: 14px; font-size: 14px; line-height: 1.5; color: #52525b; }
  .pricing-controls { display: flex; justify-content: center; align-items: center; margin-top: 28px; position: relative; font-size: 13px; }
  .toggle-pill { display: inline-flex; align-items: center; background: #f1eff8; border: none; border-radius: 99px; padding: 4px; gap: 4px; margin: 0; }
  .toggle-option { position: relative; display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 99px; font-size: 13px; font-weight: 500; color: #555170; cursor: pointer; transition: background 0.15s ease, color 0.15s ease; user-select: none; }
  .toggle-option[data-checked] { background: #380e87; color: #ffffff; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12); }
  .toggle-option:focus-within { outline: 2px solid #380e87; outline-offset: 2px; }
  .toggle-radio { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.001; margin: 0; cursor: pointer; z-index: 1; }
  .toggle-icon { display: block; flex-shrink: 0; }
  .currency-label { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .pricing-status, .pricing-help, noscript { text-align: center; font-size: 14px; }
  .pricing-status { margin-top: 24px; }
  .retry { display: block; margin: 16px auto; border: 1px solid var(--color-border); border-radius: 99px; padding: 10px 20px; background: var(--color-primary-wash); }
  .plan-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: start; gap: 20px; margin-top: 40px; }
  .plan, .plan-skeleton { min-width: 0; border: 1px solid #e5e7eb; border-radius: 16px; background: white; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04); }
  .plan { overflow-wrap: anywhere; display: flex; flex-direction: column; }
  .plan-skeleton { min-height: 728px; background: var(--color-surface); }
  .plan.popular { border: 2px solid #7d52f4; border-radius: 16px; box-shadow: 0 8px 30px -4px rgba(125, 82, 244, 0.22), 0 2px 6px rgba(125, 82, 244, 0.1); overflow: hidden; }
  .plan.subtle { border-color: #e5e7eb; }
  .popular-label { text-align: center; color: white; background: #7d52f4; font-size: 13px; font-weight: 500; padding: 9px 16px; line-height: 1.4; margin: 0; letter-spacing: 0.01em; }
  .plan-body { display: flex; flex-direction: column; padding: 24px 22px 28px; background: white; }
  .popular .plan-body { padding: 22px 22px 28px; }
  h3 { margin: 0; font-size: 22px; font-weight: 600; line-height: 1.25; color: #111827; letter-spacing: -0.01em; }
  .plan-description { margin-top: 4px; font-size: 13px; line-height: 1.4; color: #6b7280; }
  .plan-price { margin-top: 10px; color: #111827; display: flex; align-items: baseline; gap: 2px; }
  .plan-price strong { font-size: 30px; font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; color: #111827; }
  .plan-price [data-price-period] { font-size: 13px; color: #9ca3af; margin-left: 2px; font-weight: 400; }
  .currency-fallback, .team-total { font-size: 12px; color: var(--color-paragraph); }
  .seat-control { display: flex; gap: 8px; align-items: center; margin-block: 8px; font-size: 14px; }
  .seat-control input { min-width: 0; width: 90px; border: 1px solid var(--color-border); border-radius: 8px; padding: 8px; }
  .token-value { display: flex; gap: 6px; align-items: center; min-height: 32px; margin-top: 12px; padding: 6px 10px; border: 1px solid #e0d5fe; background: #faf8ff; border-radius: 6px; font-size: 12px; font-weight: 500; line-height: 1.4; color: #7d52f4; }
  .token-stars { display: flex; align-items: center; justify-content: center; width: 14px; height: 14px; flex-shrink: 0; }
  .token-stars :global(img) { width: 14px; height: 14px; }
  .pricing :global(.pricing-cta) { width: 100%; margin-top: 16px; height: 42px; min-height: 42px; padding: 0 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 500; border-radius: 99px; border: 1px solid #ebebf0; background: #f8f8fa; color: #111827; box-shadow: none; transition: background 0.15s ease, border-color 0.15s ease; }
  .pricing :global(.pricing-cta:hover) { background: #f1eff8; border-color: #dcd7ee; }
  .popular :global(.pricing-cta) { background: #380e87; border-color: #380e87; color: #ffffff; box-shadow: 0 2px 6px rgba(56, 14, 135, 0.2); }
  .popular :global(.pricing-cta:hover) { background: #2b0b68; border-color: #2b0b68; }
  .plan-models { margin-top: 16px; padding: 12px; border: 1px solid #e5e7eb; border-radius: 12px; background: #ffffff; }
  .models-heading { display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid #f3f4f6; font-size: 11px; margin-bottom: 10px; }
  .models-heading > span:first-child { text-transform: uppercase; font-weight: 600; letter-spacing: 0.06em; color: #6b7280; }
  .model-count { background: #ede9fe; color: #7c3aed; border-radius: 99px; padding: 2px 8px; font-weight: 500; font-size: 11px; }
  .plan-models ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .plan-models :global(li) { display: flex; gap: 8px; align-items: center; font-size: 12px; line-height: 1.35; color: #374151; }
  .plan-models :global(.model-icon) { display: grid; flex: 0 0 20px; width: 20px; height: 20px; place-items: center; background: #f4f4f5; border-radius: 50%; overflow: hidden; flex-shrink: 0; }
  .pricing :global(.gemini-scale) { width: 16.667px; height: 16.667px; }
  .pricing :global(.gemini-scale img) { transform: scale(.52084375); transform-origin: top left; }
  summary { display: inline-flex; gap: 4px; align-items: center; margin-top: 8px; cursor: pointer; font-size: 12px; font-weight: 500; color: #7d52f4; }
  summary::-webkit-details-marker { display: none; }
  .more-arrow { display: inline-flex; transform: scaleY(-1); }
  details[open] .more-arrow { transform: none; }
  [data-model-status] { font-size: 11px; color: var(--color-muted); margin-top: 6px; }
  [data-model-status]:empty { display: none; }
  .plan-features { display: grid; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
  .plan-features :global(li) { display: flex; gap: 8px; align-items: center; font-size: 13px; line-height: 1.4; color: #374151; }
  .feature-yes { display: grid; place-items: center; flex: 0 0 16px; width: 16px; height: 16px; border-radius: 99px; background: #ede9fe; }
  .feature-yes :global(img) { width: 9px; height: 9px; }
  .feature-no { display: none; flex: 0 0 16px; width: 16px; height: 16px; }
  .plan-features :global(.unavailable .feature-yes) { display: none; }
  .plan-features :global(.unavailable .feature-no) { display: block; }
  .plan-features :global(.unavailable) { color: #b0b5c3; }
  .pricing-help { margin-top: 28px; text-align: center; font-size: 13px; color: var(--color-primary-deep); }
  @media (max-width: 1279px) { .plan-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  @media (max-width: 767px) { .pricing { margin-block: 48px; } .pricing :global(.section-heading h2) { font-size: 30px; line-height: 1.3; } .plan-grid { gap: 16px; margin-top: 32px; } }
  @media (max-width: 599px) { .plan-grid { grid-template-columns: 1fr; } .plan-body { padding: 20px; } }
</style>
