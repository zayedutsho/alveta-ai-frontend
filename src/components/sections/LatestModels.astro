---
import type { ModelsContent } from '../../types/content';
import SectionHeading from '../common/SectionHeading.astro';
import FigmaAsset from '../common/FigmaAsset.astro';
interface Props { content: ModelsContent; }
const { content } = Astro.props;
---
<section id="models" class="latest-models" aria-labelledby="models-heading" data-latest-models data-content-status={content.status}>
  <div class="container">
    <SectionHeading id="models-heading" heading={content.heading} description={content.description} layout="split-wide" />
    <div class="model-cards">
      {content.cards.map(card => <article class="model-card" data-model-card={card.id} data-brand={card.provider.toLowerCase()}>
        <a class="model-link" href={card.cta.href} aria-label={card.cta.label}>
          <div class="provider"><span>{card.provider}</span><span class="arrow" aria-hidden="true"><FigmaAsset name="model-arrow-down-left01" /></span></div>
          <div class="model-name"><span class="model-icon" aria-hidden="true"><FigmaAsset name={card.icon} /></span><h3>{card.name}</h3></div>
          <div class="benchmark"><p>{card.benchmark}</p><p>{card.tested}</p></div>
        </a>
      </article>)}
    </div>
  </div>
</section>
<style>
  .latest-models { margin-top: 73px; padding-block: 100px 50px; background: var(--color-logo-surface); scroll-margin-top: 24px; }
  .model-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); margin-top: var(--space-11); }
  .model-card { min-width: 0; background: var(--color-white); border-radius: var(--radius-sm); }
  .model-link { display: block; padding: var(--space-6); border-radius: inherit; }
  .provider { display: flex; justify-content: space-between; gap: var(--space-4); align-items: start; text-transform: uppercase; color: var(--color-paragraph); }
  .arrow { transform: rotate(180deg); }
  .model-name { display: flex; gap: var(--space-3); align-items: center; margin-top: var(--space-4); min-height: 34px; }
  .model-icon { flex-shrink: 0; }
  h3 { margin: 0; color: var(--color-heading); font-size: 28px; line-height: 34px; font-weight: 500; white-space: nowrap; }
  .benchmark { margin-top: var(--space-6); }
  .benchmark p:first-child { color: var(--color-primary); font-weight: 500; line-height: 16px; }
  .benchmark p + p { margin-top: 6px; color: var(--color-paragraph); }
  .model-card {
    --brand-color: #10a37f;
    --brand-ink: #081411;
    --reveal: 0;
    --lift: 0px;
    --arrow-shift: 0px;
    position: relative;
    isolation: isolate;
    transform: translateY(var(--lift));
    box-shadow: 0 12px 24px -12px var(--active-shadow, transparent);
    transition: transform 400ms cubic-bezier(.22, 1, .36, 1), box-shadow 400ms ease, border-radius 400ms cubic-bezier(.22, 1, .36, 1);
  }
  .model-card[data-brand*="google"] { --brand-color: #3186ff; --hover-logo-filter: none; }
  .model-card[data-brand*="anthropic"] { --brand-color: #df7658; }
  .model-card[data-brand*="xai"] { --brand-color: #000; }
  .model-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--brand-color);
    clip-path: inset(calc((1 - var(--reveal)) * 100%) 0 0 0);
    transition: clip-path 400ms cubic-bezier(.22, 1, .36, 1);
    pointer-events: none;
  }
  .model-card:has(.model-link:focus-visible) {
    --reveal: 1;
    --lift: -3px;
    --arrow-shift: 3px;
    --active-shadow: color-mix(in srgb, var(--brand-color) 35%, transparent);
    --active-ink: #fff;
    --active-arrow-filter: brightness(0) invert(1);
    --active-logo-filter: var(--hover-logo-filter, brightness(0) invert(1));
    border-bottom-right-radius: 44px;
  }
  @media (hover: hover) and (pointer: fine) {
    .model-card:hover {
      --reveal: 1;
      --lift: -3px;
      --arrow-shift: 3px;
      --active-shadow: color-mix(in srgb, var(--brand-color) 35%, transparent);
      --active-ink: #fff;
      --active-arrow-filter: brightness(0) invert(1);
      --active-logo-filter: var(--hover-logo-filter, brightness(0) invert(1));
      border-bottom-right-radius: 44px;
    }
  }
  .model-link:focus-visible { outline: 3px solid var(--brand-color); outline-offset: 4px; }
  .provider { color: var(--active-ink, var(--color-paragraph)); }
  h3 { color: var(--active-ink, var(--color-heading)); }
  .benchmark p:first-child { color: var(--active-ink, var(--color-primary)); }
  .benchmark p + p { color: var(--active-ink, var(--color-paragraph)); }
  .provider, h3, .benchmark p { transition: color 400ms ease; }
  .model-icon { filter: var(--active-logo-filter, none); transition: filter 400ms ease; }
  .arrow {
    transform: translate(var(--arrow-shift), calc(-1 * var(--arrow-shift))) rotate(180deg);
    filter: var(--active-arrow-filter, none);
    transition: transform 400ms cubic-bezier(.22, 1, .36, 1), filter 400ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .model-card, .model-card::before, .provider, h3, .benchmark p, .model-icon, .arrow { transition: none; }
    .model-card { transform: none; }
    .arrow { transform: rotate(180deg); }
  }
  @media (max-width: 1279px) { .model-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .latest-models { margin-top: 44px; padding-block: 48px; } .model-cards { margin-top: 32px; gap: var(--space-4); } h3 { font-size: 24px; } }
  @media (max-width: 599px) { .model-cards { grid-template-columns: 1fr; } }
</style>
