---
import FigmaAsset from '../common/FigmaAsset.astro';
import type { AnnouncementContent } from '../../types/content';
interface Props { content: AnnouncementContent; }
const { content } = Astro.props;
---
<aside class="announcement" aria-label="Alveta announcement" data-announcement>
  <img class="announcement-bg" src="/images/figma/anausment.png" alt="" aria-hidden="true" />
  <span class="badge">{content.badge}</span>
  <p class="message"><span class="full-message">{content.message}</span><span class="short-message">{content.shortMessage}</span></p>
  <a class="announcement-link" href={content.cta.href}>{content.cta.label}<FigmaAsset name="arrow-right3" /></a>
  <button type="button" class="dismiss" aria-label="Dismiss announcement" data-dismiss-announcement><FigmaAsset name="huge-icon-interface-outline-remove" /></button>
</aside>
<script>
  document.querySelector<HTMLButtonElement>('[data-dismiss-announcement]')?.addEventListener('click', () => {
    document.querySelector<HTMLElement>('[data-announcement]')?.setAttribute('hidden', '');
    document.querySelector<HTMLAnchorElement>('[data-home-link]')?.focus();
  });
</script>
<style>
  .announcement { position: relative; z-index: 3; min-height: 40px; display: flex; align-items: center; justify-content: center; gap: 15px; padding: 8px 64px; background: var(--color-primary-deep); color: white; font-size: 14px; line-height: 1.4; }
  .announcement-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1; pointer-events: none; }
  .badge { flex-shrink: 0; min-width: 52px; text-align: center; padding: 2px 8px; background: linear-gradient(#e13065, #ffb5cb); color: #000; border-radius: 99px; }
  .announcement-link { display: inline-flex; align-items: center; gap: 2px; white-space: nowrap; font-weight: 500; text-decoration: underline; text-underline-offset: 3px; }
  .announcement-link:focus-visible, .dismiss:focus-visible { outline-color: white; }
  .dismiss { position: absolute; right: max(24px, calc((100vw - 1320px) / 2)); top: 0; width: 40px; height: 40px; border: 0; background: transparent; display: grid; place-items: center; }
  .short-message { display: none; }
  @media (max-width: 900px) {
    .announcement { padding-inline: 16px; min-height: 36px; gap: 15px; }
    .full-message, .dismiss { display: none; }
    .short-message { display: inline; }
    .badge { min-width: 0; font-size: 12px; }
    .announcement-link { font-size: 12px; }
    .announcement-link :global(img) { transform: scale(.8889); }
  }
  @media (max-width: 390px) {
    .announcement { gap: 8px; padding-inline: 10px; }
    .message { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; font-size: 12px; }
  }
</style>
