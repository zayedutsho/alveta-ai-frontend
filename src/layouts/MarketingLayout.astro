---
import '@fontsource/faculty-glyphic/latin-400.css';
import heroFont from '@fontsource/faculty-glyphic/files/faculty-glyphic-latin-400-normal.woff2?url';
import '../styles/global.css';
import '../styles/motion.css';
import { marketingDefaults } from '../content/marketing';
interface Props { title?: string; description?: string; socialImageAlt?: string; }
const { title = marketingDefaults.seo.title, description = marketingDefaults.seo.description } = Astro.props;
const siteOrigin = import.meta.env.PUBLIC_SITE_ORIGIN || 'https://alveta.ai/';
const canonical = new URL(Astro.url.pathname, siteOrigin);
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const socialImage = new URL('/OpenGraphbanner.png', siteOrigin).href;
const homeUrl = new URL('/', siteOrigin).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': homeUrl + '#organization', name: 'Alveta', url: homeUrl },
    {
      '@type': 'WebSite', '@id': homeUrl + '#website', name: 'Alveta', url: homeUrl,
      publisher: { '@id': homeUrl + '#organization' },
    },
    {
      '@type': 'WebPage', '@id': canonical.href + '#webpage', url: canonical.href, name: title, description,
      isPartOf: { '@id': homeUrl + '#website' }, about: { '@id': homeUrl + '#application' },
    },
    {
      '@type': 'SoftwareApplication', '@id': homeUrl + '#application', name: 'Alveta', url: homeUrl,
      description, applicationCategory: 'ProductivityApplication', operatingSystem: 'Web',
      publisher: { '@id': homeUrl + '#organization' },
    },
  ],
};
const sharingImage = Astro.locals.cmsMedia?.['/OpenGraphbanner.png'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alveta.ai" />
    <meta property="og:image" content={sharingImage?.src ?? socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={Astro.props.socialImageAlt ?? 'Alveta.ai — All Your AI Tools in One Subscription'} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={sharingImage?.src ?? socialImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-display-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={heroFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script>import '../scripts/motion';</script>
  </body>
</html>
